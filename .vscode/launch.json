{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug IPC_Producer (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Debug/IPC_Producer/IPC_Producer",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build IPC_Producer (Debug)"
        },
        {
