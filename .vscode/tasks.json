{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "problemMatcher": []
        },
        {
            "label": "cmake: configure (Release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "Release"],
            "problemMatcher": []
        },
        {
            "label": "cmake: build IPC_Producer (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug", "--target", "IPC_Producer"],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "cmake: build IPC_Consumer (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug", "--target", "IPC_Consumer"],
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "cmake: build IPC_Producer (Release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "Release", "--target", "IPC_Producer"],
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "cmake: build IPC_Consumer (Release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "Release", "--target", "IPC_Consumer"],
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
